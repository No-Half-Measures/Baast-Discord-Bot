# Local Development Environment Configuration
# Copy this to .env for local development. Never commit .env.

# Environment Type
ENVIRONMENT=local
TESTING=True
DEBUG=True

# Django Settings
SECRET_KEY=SECRET_KEY
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=DB_NAME
DB_USER=DB_USER
DB_PASSWORD=DB_PASSWORD
DB_HOST=db
DB_PORT=5432

# Redis Configuration (must match --requirepass in docker-compose.yaml)
REDIS_PASSWORD=REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# Discord Bot Configuration
DISCORD_CLIENT_ID=DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=DISCORD_CLIENT_SECRET
DISCORD_TOKEN=DISCORD_TOKEN

# Stripe Configuration (used when TESTING=True)
STRIPE_PUBLISHABLE_KEY_TEST=STRIPE_PUBLISHABLE_KEY_TEST
STRIPE_SECRET_KEY_TEST=STRIPE_SECRET_KEY_TEST
STRIPE_ENDPOINT_SECRET_TEST=STRIPE_ENDPOINT_SECRET_TEST

# Stripe Live Configuration (used when TESTING=False)
STRIPE_PUBLISHABLE_KEY_LIVE=STRIPE_PUBLISHABLE_KEY_LIVE
STRIPE_SECRET_KEY_LIVE=STRIPE_SECRET_KEY_LIVE
STRIPE_ENDPOINT_SECRET_LIVE=STRIPE_ENDPOINT_SECRET_LIVE

# Stripe Product IDs
STRIPE_PRODUCT_ID_NORMAL=STRIPE_PRODUCT_ID_NORMAL
STRIPE_PRODUCT_ID_TRIO=STRIPE_PRODUCT_ID_TRIO

# Stripe Price IDs
STRIPE_PRICE_ID_NORMAL_MONTHLY=STRIPE_PRICE_ID_NORMAL_MONTHLY
STRIPE_PRICE_ID_NORMAL_YEARLY=STRIPE_PRICE_ID_NORMAL_YEARLY
STRIPE_PRICE_ID_TRIO_MONTHLY=STRIPE_PRICE_ID_TRIO_MONTHLY
STRIPE_PRICE_ID_TRIO_YEARLY=STRIPE_PRICE_ID_TRIO_YEARLY

# Google Service Account (path to the JSON key file; keep it out of git)
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json

# Hash Salt
HASH_SALT=HASH_SALT
