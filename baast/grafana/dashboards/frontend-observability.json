    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto", "inspect": false },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [{ "id": "displayName", "value": "Events" }]
          },
          {
            "matcher": { "id": "byName", "options": "Value #B" },
            "properties": [{ "id": "displayName", "value": "Errors" }]
          },
          {
            "matcher": { "id": "byName", "options": "session_id" },
            "properties": [
              { "id": "displayName", "value": "Session ID" },
              { "id": "links", "value": [{ "title": "Filter journey", "url": "/d/frontend-observability?var-session_id=${__value.text}&${__url_time_range}" }] }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Errors" }]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "topk(50, sum by (session_id, app_name, browser_name, page_url) (count_over_time({job=\"faro\", app_name=~\"$app_name\"} | json | session_id != \"\" [$__range])))",
          "format": "table",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (session_id) (count_over_time({job=\"faro\", app_name=~\"$app_name\"} | json | kind=\"exception\" | session_id != \"\" [$__range]))",
          "format": "table",
          "instant": true,
          "queryType": "instant",
          "refId": "B"
        }
      ],
      "title": "User Sessions",
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "session_id": 0,
              "app_name": 1,
              "browser_name": 2,
              "page_url": 3,
              "Value #A": 4,
              "Value #B": 5
            },
            "renameByName": {
              "Value #A": "Events",
              "Value #B": "Errors",
              "app_name": "App",
              "browser_name": "Browser",
              "page_url": "Last Page"
            }
          }
        }
      ],
      "type": "table"
    },
